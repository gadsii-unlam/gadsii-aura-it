# BuffetYa! — environment template
# Copy to src/.env and adjust. Never commit the filled file.
# Real environment variables always win over the values in .env.

# ---- Server ----
PORT=3000
# "production" disables the default backstage key (see BACKSTAGE_KEY).
NODE_ENV=development
# Comma-separated origins allowed by CORS. Only needed when the web app is
# served from another origin; with `pnpm dev` (proxy) or `pnpm start`
# (single process) everything is same-origin.
CORS_ORIGIN=http://localhost:4200

# ---- Backstage (team only, simulates the buffet staff and Mercado Pago) ----
# Key the /backstage screen asks for, sent as the x-backstage-key header.
# Outside production it defaults to "buffetya-dev"; in production the
# backstage stays disabled until you set it. Use a long random value there.
BACKSTAGE_KEY=buffetya-dev

# ---- Behaviour ----
# Minutes the counter keeps a ready order ("Te esperamos hasta las HH:MM").
PICKUP_HOLD_MINUTES=15
# Time zone of the buffet: the pickup code sequence (B-001, B-002...) restarts
# every day at midnight in this zone.
BUFFET_TIMEZONE=America/Argentina/Buenos_Aires

# ---- Storage and files (optional; paths are relative to src/backend) ----
# Folder of the JSON data file (db.json). Gitignored.
# DATA_DIR=data
# Demo menu.
# SEED_FILE=data/seed/products.json
# Built Angular app served by Nest. Set SERVE_WEB=false to serve the API only.
# WEB_DIR=../frontend/dist/frontend/browser
# SERVE_WEB=true

# ---- Planned integrations, NOT used by the MVP ----
# The MVP keeps data in a JSON file behind repository ports and simulates
# Mercado Pago. These are kept for the Firebase / Mercado Pago adapters.
# FIREBASE_PROJECT_ID=
# FIREBASE_SERVICE_ACCOUNT_PATH=
# FIREBASE_VAPID_KEY=
# MERCADOPAGO_ACCESS_TOKEN=
# MERCADOPAGO_PUBLIC_KEY=
# MERCADOPAGO_WEBHOOK_SECRET=
