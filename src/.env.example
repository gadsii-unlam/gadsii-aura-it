# BuffetYa! — environment template
# Copy to .env and fill in. Never commit the filled file.

# ---- Backend ----
PORT=3000
NODE_ENV=development
CORS_ORIGIN=http://localhost:4200

# ---- Firebase (server side) ----
# Path to the service account JSON, or paste the JSON into FIREBASE_SERVICE_ACCOUNT.
FIREBASE_PROJECT_ID=
FIREBASE_SERVICE_ACCOUNT_PATH=
FIREBASE_DATABASE_URL=

# ---- Firebase (client side, safe to expose in the browser bundle) ----
FIREBASE_API_KEY=
FIREBASE_AUTH_DOMAIN=
FIREBASE_STORAGE_BUCKET=
FIREBASE_MESSAGING_SENDER_ID=
FIREBASE_APP_ID=

# Web Push certificate key pair, from Firebase Console > Cloud Messaging.
FIREBASE_VAPID_KEY=

# ---- Mercado Pago ----
# Use TEST- credentials while developing.
MERCADOPAGO_ACCESS_TOKEN=
MERCADOPAGO_PUBLIC_KEY=
MERCADOPAGO_WEBHOOK_SECRET=
MERCADOPAGO_SUCCESS_URL=http://localhost:4200/pedido
MERCADOPAGO_FAILURE_URL=http://localhost:4200/checkout
